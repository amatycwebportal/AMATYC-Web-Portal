// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PROJECT_LEAD
  LOCAL_LEADER
  FACULTY
  USER
}

model Institution {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users      User[]
  courseBins CourseBin[]

  @@index([name])
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  googleId      String   @unique
  name          String
  email         String   @unique
  avatarUrl     String?
  role          UserRole
  institutionId String?  @db.Uuid

  assignedRubrics   Rubric[] @relation("UserAssignedRubrics")
  inProgressRubrics Rubric[] @relation("UserInProgressRubrics")
  completedRubrics  Rubric[] @relation("UserCompletedRubrics")

  institution    Institution?    @relation(fields: [institutionId], references: [id])
  userCourseBins UserCourseBin[]
  responses      Response[]

  invitations Invitation[] @relation("UserInvitations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rubric {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String
  active      Boolean @default(true)

  assignedUsers   User[] @relation("UserAssignedRubrics")
  inProgressUsers User[] @relation("UserInProgressRubrics")
  completedUsers  User[] @relation("UserCompletedRubrics")

  scales Scale[]
}

model Scale {
  id                String  @id @default(uuid()) @db.Uuid
  rubricId          String  @db.Uuid
  prompt            String
  levelDescriptions Json?
  section           String?
  orderIndex        Int
  editable          Boolean @default(true)
  isGlobal          Boolean @default(false)

  rubric    Rubric     @relation(fields: [rubricId], references: [id])
  responses Response[]
  scaleBins ScaleBin[]

  @@index([rubricId])
}

model PredefinedCourseBin {
  id      String @id @default(uuid()) @db.Uuid
  binName String

  courseBins CourseBin[]
  scaleBins  ScaleBin[]
}

model CourseBin {
  id              String @id @default(uuid()) @db.Uuid
  institutionId   String @db.Uuid
  predefinedBinId String @db.Uuid
  displayName     String

  institution         Institution         @relation(fields: [institutionId], references: [id])
  predefinedCourseBin PredefinedCourseBin @relation(fields: [predefinedBinId], references: [id])
  courses             Course[]
  userCourseBins      UserCourseBin[]

  @@index([institutionId])
  @@index([predefinedBinId])
}

model Course {
  id           String @id @default(uuid()) @db.Uuid
  courseBinId  String @db.Uuid
  courseNumber String
  courseName   String

  courseBin CourseBin  @relation(fields: [courseBinId], references: [id])
  responses Response[]

  @@index([courseBinId])
}

model ScaleBin {
  scaleId         String @db.Uuid
  predefinedBinId String @db.Uuid

  scale               Scale               @relation(fields: [scaleId], references: [id])
  predefinedCourseBin PredefinedCourseBin @relation(fields: [predefinedBinId], references: [id])

  @@id([scaleId, predefinedBinId])
  @@index([predefinedBinId])
}

model UserCourseBin {
  userId      String @db.Uuid
  courseBinId String @db.Uuid

  user      User      @relation(fields: [userId], references: [id])
  courseBin CourseBin @relation(fields: [courseBinId], references: [id])

  @@id([userId, courseBinId])
  @@index([courseBinId])
}

model Response {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  scaleId     String   @db.Uuid
  courseId    String   @db.Uuid
  score       Int
  submittedAt DateTime @default(now()) @map("submitted_at")

  user   User   @relation(fields: [userId], references: [id])
  scale  Scale  @relation(fields: [scaleId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@index([userId])
  @@index([scaleId])
  @@index([courseId])
}
model Invitation {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.Text
  institutionId String    @db.Uuid
  role          UserRole
  token         String    @unique
  invitedById   String?   @db.Uuid
  invitedByUser User?     @relation("UserInvitations", fields: [invitedById], references: [id])
  acceptedAt    DateTime?
  expiresAt     DateTime  @default(dbgenerated("now() + interval '7 days'"))
  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([institutionId])
  @@index([token])
}
