generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users      User[]
  courseBins CourseBin[]

  @@index([name])
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  googleId      String   @unique
  name          String
  email         String   @unique
  avatarUrl     String?
  role          UserRole
  institutionId String?  @db.Uuid

  rubricAssignments UserRubricAssignment[]

  institution    Institution?    @relation(fields: [institutionId], references: [id])
  userCourseBins UserCourseBin[]
  responses      Response[]

  invitations Invitation[] @relation("UserInvitations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model RubricVersion {
  id          String   @id @default(uuid()) @db.Uuid
  rubricId    String   @db.Uuid
  versionNum  Int
  changelog   String?
  publishedAt DateTime @default(now())
  rubric      Rubric   @relation(fields: [rubricId], references: [id])

  scaleVersions ScaleVersion[]
  assignments   UserRubricAssignment[]

  @@unique([rubricId, versionNum])
  @@index([rubricId])
}

model Scale {
  id                String     @id @default(uuid()) @db.Uuid
  rubricId          String     @db.Uuid
  prompt            String
  orderIndex        Int
  editable          Boolean    @default(true)
  isGlobal          Boolean    @default(false)
  levelDescriptions Json?
  section           String?
  responses         Response[]
  rubric            Rubric     @relation(fields: [rubricId], references: [id])
  scaleBins         ScaleBin[]

  @@index([rubricId])
}


model ScaleVersion {
  id                String   @id @default(uuid()) @db.Uuid
  rubricVersionId   String   @db.Uuid
  originalScaleId   String   @db.Uuid  // which Scale row this was cloned from
  prompt            String
  orderIndex        Int
  isGlobal          Boolean
  editable          Boolean
  levelDescriptions Json?
  section           String?

  rubricVersion    RubricVersion    @relation(fields: [rubricVersionId], references: [id])
  scaleVersionBins ScaleVersionBin[]
  responses        Response[]

  @@index([rubricVersionId])
  @@index([originalScaleId])
}

model ScaleVersionBin {
  scaleVersionId  String       @db.Uuid
  predefinedBinId String       @db.Uuid

  scaleVersion        ScaleVersion        @relation(fields: [scaleVersionId], references: [id])
  predefinedCourseBin PredefinedCourseBin @relation(fields: [predefinedBinId], references: [id])

  @@id([scaleVersionId, predefinedBinId])
  @@index([predefinedBinId])
}
model UserRubricAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  rubricVersionId String           @db.Uuid
  status          AssignmentStatus
  assignedAt      DateTime         @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  user          User          @relation(fields: [userId], references: [id])
  rubricVersion RubricVersion @relation(fields: [rubricVersionId], references: [id])

  @@unique([userId, rubricVersionId])
  @@index([rubricVersionId])
  @@index([userId])
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

model Rubric {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String
  active      Boolean @default(true)

  scales   Scale[]         
  versions RubricVersion[]
}


model Response {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  scaleVersionId   String   @db.Uuid
  rubricVersionId  String   @db.Uuid
  courseId         String   @db.Uuid
  score            Int
  submittedAt      DateTime @default(now()) @map("submitted_at")

  course        Course        @relation(fields: [courseId], references: [id])
  scaleVersion  ScaleVersion  @relation(fields: [scaleVersionId], references: [id])
  rubricVersion RubricVersion @relation(fields: [rubricVersionId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([scaleVersionId])
  @@index([rubricVersionId])
  @@index([courseId])
}






model PredefinedCourseBin {
  id         String      @id @default(uuid()) @db.Uuid
  binName    String      @unique
  courseBins CourseBin[]
  scaleBins  ScaleBin[]
  scaleVersionBins ScaleVersionBin[]
}

model CourseBin {
  id                  String              @id @default(uuid()) @db.Uuid
  institutionId       String              @db.Uuid
  predefinedBinId     String              @db.Uuid
  displayName         String
  courses             Course[]
  institution         Institution         @relation(fields: [institutionId], references: [id])
  predefinedCourseBin PredefinedCourseBin @relation(fields: [predefinedBinId], references: [id])
  userCourseBins      UserCourseBin[]
  invitations         Invitation[]        @relation("InvitationCourseBins")

  @@index([institutionId])
  @@index([predefinedBinId])
}

model Course {
  id           String     @id @default(uuid()) @db.Uuid
  courseBinId  String     @db.Uuid
  courseNumber String
  courseName   String
  courseBin    CourseBin  @relation(fields: [courseBinId], references: [id])
  responses    Response[]

  @@index([courseBinId])
}

model ScaleBin {
  scaleId             String              @db.Uuid
  predefinedBinId     String              @db.Uuid
  predefinedCourseBin PredefinedCourseBin @relation(fields: [predefinedBinId], references: [id])
  scale               Scale               @relation(fields: [scaleId], references: [id])

  @@id([scaleId, predefinedBinId])
  @@index([predefinedBinId])
}

model UserCourseBin {
  userId      String    @db.Uuid
  courseBinId String    @db.Uuid
  courseBin   CourseBin @relation(fields: [courseBinId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@id([userId, courseBinId])
  @@index([courseBinId])
}

model Invitation {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique @db.Text
  institutionId String      @db.Uuid
  role          UserRole
  token         String      @unique
  invitedById   String?     @db.Uuid
  invitedByUser User?       @relation("UserInvitations", fields: [invitedById], references: [id])
  acceptedAt    DateTime?
  courseBins    CourseBin[] @relation("InvitationCourseBins")
  expiresAt     DateTime    @default(dbgenerated("now() + interval '7 days'"))
  createdAt     DateTime    @default(now())

  @@index([email])
  @@index([institutionId])
  @@index([token])
}

enum UserRole {
  PROJECT_LEAD
  LOCAL_LEADER
  FACULTY
  USER
}
