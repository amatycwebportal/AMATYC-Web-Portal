generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique
  createdAt  DateTime    @default(now()) @map("created_at")
  courseBins CourseBin[]
  users      User[]

  @@index([name])
}

model User {
  id                String          @id @default(uuid()) @db.Uuid
  name              String
  email             String          @unique
  role              UserRole
  institutionId     String?         @db.Uuid
  avatarUrl         String?
  createdAt         DateTime        @default(now())
  googleId          String          @unique
  updatedAt         DateTime        @updatedAt
  Invitation        Invitation[]
  responses         Response[]
  institution       Institution?    @relation(fields: [institutionId], references: [id])
  userCourseBins    UserCourseBin[]
  assignedRubrics   Rubric[]        @relation("UserAssignedRubrics")
  completedRubrics  Rubric[]        @relation("UserCompletedRubrics")
  inProgressRubrics Rubric[]        @relation("UserInProgressRubrics")
}

model Rubric {
  id              String  @id @default(uuid()) @db.Uuid
  title           String
  description     String
  active          Boolean @default(true)
  scales          Scale[]
  assignedUsers   User[]  @relation("UserAssignedRubrics")
  completedUsers  User[]  @relation("UserCompletedRubrics")
  inProgressUsers User[]  @relation("UserInProgressRubrics")
}

model Scale {
  id                String     @id @default(uuid()) @db.Uuid
  rubricId          String     @db.Uuid
  prompt            String
  orderIndex        Int
  editable          Boolean    @default(true)
  isGlobal          Boolean    @default(false)
  levelDescriptions Json?
  section           String?
  responses         Response[]
  rubric            Rubric     @relation(fields: [rubricId], references: [id])
  scaleBins         ScaleBin[]

  @@index([rubricId])
}

model PredefinedCourseBin {
  id         String      @id @default(uuid()) @db.Uuid
  binName    String      @unique
  courseBins CourseBin[]
  scaleBins  ScaleBin[]
}

model CourseBin {
  id                  String              @id @default(uuid()) @db.Uuid
  institutionId       String              @db.Uuid
  predefinedBinId     String              @db.Uuid
  displayName         String
  courses             Course[]
  institution         Institution         @relation(fields: [institutionId], references: [id])
  predefinedCourseBin PredefinedCourseBin @relation(fields: [predefinedBinId], references: [id])
  userCourseBins      UserCourseBin[]

  @@index([institutionId])
  @@index([predefinedBinId])
}

model Course {
  id           String     @id @default(uuid()) @db.Uuid
  courseBinId  String     @db.Uuid
  courseNumber String
  courseName   String
  courseBin    CourseBin  @relation(fields: [courseBinId], references: [id])
  responses    Response[]

  @@index([courseBinId])
}

model ScaleBin {
  scaleId             String              @db.Uuid
  predefinedBinId     String              @db.Uuid
  predefinedCourseBin PredefinedCourseBin @relation(fields: [predefinedBinId], references: [id])
  scale               Scale               @relation(fields: [scaleId], references: [id])

  @@id([scaleId, predefinedBinId])
  @@index([predefinedBinId])
}

model UserCourseBin {
  userId      String    @db.Uuid
  courseBinId String    @db.Uuid
  courseBin   CourseBin @relation(fields: [courseBinId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@id([userId, courseBinId])
  @@index([courseBinId])
}

model Response {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  scaleId     String   @db.Uuid
  courseId    String   @db.Uuid
  score       Int
  submittedAt DateTime @default(now()) @map("submitted_at")
  course      Course   @relation(fields: [courseId], references: [id])
  scale       Scale    @relation(fields: [scaleId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([scaleId])
  @@index([courseId])
}

model Invitation {
  id            String    @id @db.Uuid
  email         String    @unique
  institutionId String    @db.Uuid
  role          UserRole
  token         String    @unique
  invitedById   String?   @db.Uuid
  acceptedAt    DateTime?
  expiresAt     DateTime  @default(dbgenerated("(now() + '7 days'::interval)"))
  createdAt     DateTime  @default(now())
  User          User?     @relation(fields: [invitedById], references: [id])

  @@index([email])
  @@index([institutionId])
  @@index([token])
}

enum UserRole {
  PROJECT_LEAD
  LOCAL_LEADER
  FACULTY
  USER
}
